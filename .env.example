# Copia este archivo como .env y completa los valores reales. NUNCA subas .env a Git.
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_mysql
DB_PASSWORD=cambia_esta_clave
DB_NAME=sistema_musical
# TLS hacia la base de datos (true en servicios gestionados como Aiven)
DB_SSL=false
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Orígenes permitidos por CORS, separados por coma (vacío = cualquiera, solo para desarrollo)
CORS_ORIGIN=
PORT=3000
